{
  "manifest_version": 3,
  "name": "Kelime Öğren",
  "version": "1.0",
  "description": "İngilizce-Türkçe kelime öğrenme eklentisi",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kelime Öğren",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kelime-ogren@erkanoner23.github.io",
      "strict_min_version": "109.0"
    }
  }
}